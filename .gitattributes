# Container/toolchain files must keep LF endings: CRLF from Windows checkouts
# breaks `\` line-continuations in the Containerfile and shell scripts run
# inside the Linux dev container (issue #80).
Containerfile   text eol=lf
*.sh            text eol=lf
.nvmrc          text eol=lf
compose.yaml    text eol=lf
rust-toolchain.toml text eol=lf
apps/desktop/patches/*.patch whitespace=-blank-at-eol
.dockerignore   text eol=lf

# Preserve the independently generated source-component catalog on Windows.
docs/validation/root-preparation-source-vectors.json text eol=lf

# Retain exact independent summary-detail fixture bytes on Windows.
docs/validation/hierarchy-summary-vectors.json text eol=lf

# Preserve source-bridge and compact-packing evidence bytes.
docs/validation/summary-source-packing.json text eol=lf

# Preserve independently generated preparation-join catalog bytes on Windows.
docs/validation/root-preparation-join-vectors.json text eol=lf
# The join catalog fingerprints these preserved input bytes as well.
docs/validation/root-bootstrap-vectors.json text eol=lf

# Preserve independently generated report/evaluation and R2 source bytes.
docs/validation/r2-report-vectors.json text eol=lf

# Conditional report-publication golden bytes must survive checkout unchanged.
docs/validation/report-publication-vectors.json text eol=lf

# Preserve complete independent logical preparation effect bytes.
docs/validation/root-preparation-effects.json text eol=lf

/docs/validation/root-preparation-budgets.json text eol=lf

# Preserve independent assignment budget boundary catalog bytes.
/docs/validation/assignment-aggregate-budgets.json text eol=lf

# Preserve source-traced assignment accounting input and output bytes.
/docs/validation/assignment-accounting-witnesses.json text eol=lf
/docs/validation/hierarchy-empty-output-profile.json text eol=lf
/docs/validation/hierarchy-claim-proof-vectors.json text eol=lf
