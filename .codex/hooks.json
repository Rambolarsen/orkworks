{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.orkworks/hook-scripts/report-harness-event.sh\" --marker 'orkworks:harness-integration:v2:codex'",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); bash \"$ROOT/.codex/hooks/doc-check-stop.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  }
}