# The dev target copies no source. Keep host caches/platform artifacts out
# of normal contexts; headless-replay uses a separate allowlisted private context.
# Honored by both `docker build`/`docker compose` and Podman (which falls back
# to .dockerignore when no .containerignore is present).
.git
node_modules
**/node_modules
target
**/target
dist
dist-electron
out
release
.orkworks
.worktrees
apm_modules
.agents
