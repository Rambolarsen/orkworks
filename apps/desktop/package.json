{
  "name": "orkworks-desktop",
  "productName": "OrkWorks",
  "version": "0.2.0",
  "description": "OrkWorks — Mission Control for AI Agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rambolarsen/orkworks.git"
  },
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "postinstall": "node scripts/setup-electron.mjs",
    "dev": "pnpm build:rust && pnpm build:native && tsc -p tsconfig.node.json && node scripts/build-preload.mjs && node scripts/dev.mjs",
    "build": "pnpm build:native && tsc -p tsconfig.node.json && node scripts/build-preload.mjs && vite build",
    "build:native": "electron-builder install-app-deps",
    "build:rust": "cargo build --manifest-path ../../crates/orkworksd/Cargo.toml",
    "build:rust:release": "cargo build --release --manifest-path ../../crates/orkworksd/Cargo.toml",
    "package:release": "node scripts/package-release.mjs",
    "verify:release": "node scripts/verifyReleaseArtifact.mjs",
    "verify:release:pre-checksum": "node scripts/verifyReleaseArtifact.mjs --pre-checksum",
    "checksum:release": "node scripts/releaseMetadata.mjs --checksums",
    "smoke:windows-installer": "node scripts/windowsInstallerSmokeTest.mjs",
    "dist": "pnpm build:native && tsc -p tsconfig.node.json && node scripts/build-preload.mjs && vite build && node scripts/package-release.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^6.6.1",
    "dockview-react": "^6.6.1",
    "electron-updater": "6.8.9",
    "fs-ext": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.1.1",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
